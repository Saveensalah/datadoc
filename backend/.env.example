# Copy this file to .env and fill in your local values.
# .env is gitignored — never commit real passwords.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Used to sign the anonymous session cookie and derive session-role passwords.
# Keep this stable and private in production. If omitted, DB_PASSWORD is used.
SESSION_SECRET=your_long_random_session_secret

# Set true when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
